.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20rpx);
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 999;
}
.tabbar-inner {
  display: flex;
  gap: 16rpx;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s;
  background: transparent;
}
.tab-item.active {
  background: rgba(74,55,40,0.12);
  box-shadow: inset 0 0 0 2rpx rgba(74,55,40,0.3);
}
.tab-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
  opacity: 0.6;
}
.tab-item.active .tab-icon {
  opacity: 1;
}
.tab-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #86868b;
  letter-spacing: 2rpx;
}
.tab-item.active .tab-label {
  color: #4A3728;
}
