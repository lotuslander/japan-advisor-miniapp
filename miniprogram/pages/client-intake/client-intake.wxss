.page { padding: 20rpx; }
.hero { padding: 30rpx 20rpx; }
.hero-title { font-size: 36rpx; font-weight: bold; color: #C04851; }
.hero-sub { font-size: 24rpx; color: #999; margin-top: 10rpx; }

.record-card { background: #fff; border-radius: 12rpx; padding: 40rpx 24rpx; margin-bottom: 20rpx; text-align: center; }
.record-btn { background: #C04851; color: #fff; font-size: 28rpx; padding: 30rpx; border-radius: 50%; width: 200rpx; height: 200rpx; line-height: 140rpx; margin: 0 auto; }
.record-btn.recording { background: #E8A838; }
.record-hint { font-size: 22rpx; color: #999; margin-top: 20rpx; line-height: 1.6; }
.transcript-input {
  width: 100%;
  box-sizing: border-box;
  margin-top: 20rpx;
  min-height: 120rpx;
  padding: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #444;
  background: #F8F4EC;
  border: 1rpx solid #e0d8c8;
  border-radius: 8rpx;
  text-align: left;
}
.transcript-tip { font-size: 20rpx; color: #4a9d5b; margin-top: 8rpx; text-align: right; }

.card { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: #2D2D2D; }
.transcript { font-size: 24rpx; color: #444; line-height: 1.6; background: #F8F4EC; padding: 16rpx; border-radius: 8rpx; margin-bottom: 16rpx; }

.info-row { display: flex; padding: 12rpx 0; border-bottom: 1rpx solid #f0ebe0; }
.info-lbl { width: 160rpx; font-size: 26rpx; color: #999; }
.info-val { flex: 1; font-size: 26rpx; font-weight: 600; color: #2D2D2D; }

.missing-box { background: #fff8e8; padding: 16rpx; border-radius: 8rpx; margin-top: 16rpx; border-left: 4rpx solid #E8A838; }
.missing-title { font-size: 24rpx; font-weight: 600; color: #E8A838; margin-bottom: 8rpx; }
.missing-item { font-size: 22rpx; color: #444; padding: 4rpx 0; }
.missing-hint { font-size: 22rpx; color: #999; margin-top: 8rpx; }

.match-box { background: #f0f8f0; padding: 20rpx; border-radius: 8rpx; margin-top: 16rpx; text-align: center; }
.match-title { font-size: 24rpx; color: #4a9d5b; }
.match-score { font-size: 48rpx; font-weight: bold; color: #4a9d5b; margin: 10rpx 0; }
.match-level { font-size: 24rpx; color: #444; }
.match-suggestion { font-size: 22rpx; color: #999; margin-top: 10rpx; }

.btn { text-align: center; padding: 20rpx; border-radius: 8rpx; font-size: 26rpx; margin-top: 16rpx; }
.btn.primary { background: #C04851; color: #fff; }
.btn.success { background: #4a9d5b; color: #fff; }
