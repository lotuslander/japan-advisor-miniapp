.page { padding-bottom: 40rpx; }

.hero { padding: 48rpx 40rpx 32rpx; }
.hero-hello { font-size: 44rpx; font-weight: 600; color: #2D2D2D; letter-spacing: 6rpx; }
.hero-sub { font-size: 26rpx; color: #888; margin-top: 12rpx; letter-spacing: 1rpx; }
.hero-line { width: 80rpx; height: 4rpx; background: #C04851; margin-top: 24rpx; }

/* AI政策更新按钮 */
.ai-update-banner {
  display: flex; align-items: center;
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #4A3728 0%, #6B5344 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(74, 55, 40, 0.2);
  transition: all 0.3s;
}
.ai-update-banner:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(74, 55, 40, 0.3);
}
.ai-update-banner.searching {
  background: linear-gradient(135deg, #C04851 0%, #E06871 100%);
  animation: pulse 1.5s infinite;
}
.ai-update-banner.case {
  background: linear-gradient(135deg, #2D5F3F 0%, #4A8B5F 100%);
}
.ai-update-banner.case.searching {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
}
@keyframes pulse {
  0%, 100% { box-shadow: 0 4rpx 16rpx rgba(192, 72, 81, 0.3); }
  50% { box-shadow: 0 4rpx 32rpx rgba(192, 72, 81, 0.6); }
}
.ai-update-icon { font-size: 48rpx; margin-right: 20rpx; }
.ai-update-text { flex: 1; }
.ai-update-title { font-size: 30rpx; color: #F8F4EC; font-weight: 600; }
.ai-update-desc { font-size: 22rpx; color: #D4C4B0; margin-top: 6rpx; }
.ai-update-arrow { font-size: 32rpx; color: #F8F4EC; }

.policy-item { padding: 24rpx 0; border-bottom: 1rpx solid #e8e0d0; }
.policy-item:last-child { border-bottom: none; }
.policy-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.policy-date { font-size: 24rpx; color: #999; }
.policy-title { font-size: 30rpx; font-weight: 600; color: #2D2D2D; margin-bottom: 8rpx; }
.policy-summary { font-size: 26rpx; color: #555; line-height: 1.7; }
.grid { display: flex; flex-wrap: wrap; }
.grid-item {
  width: 25%; text-align: center;
  padding: 20rpx 0; position: relative;
}
.grid-icon {
  width: 96rpx; height: 96rpx; margin: 0 auto 12rpx;
  background: #FDFBF6;
  border: 1rpx solid #d8d0c0;
  display: flex; align-items: center; justify-content: center;
}
.grid-label { font-size: 24rpx; color: #555; letter-spacing: 1rpx; }
