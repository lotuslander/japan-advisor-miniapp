.client-item {
  display: flex; align-items: center;
  padding: 24rpx 0; border-bottom: 1rpx solid #e8e0d0;
}
.client-item:last-child { border-bottom: none; }
.client-avatar {
  width: 80rpx; height: 80rpx;
  background: #e8e0d0; color: #2D2D2D;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600;
  margin-right: 24rpx;
}
.client-info { flex: 1; }
.client-name { font-size: 28rpx; font-weight: 600; color: #2D2D2D; }
.client-path { color: #999; font-size: 24rpx; }
.client-note { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.client-deadline { font-size: 24rpx; color: #999; }
.client-deadline.urgent { color: #C04851; font-weight: 600; }

/* 路径比较（ルート比較）· 双列对比 */
.news-item { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f0e8d8; }
.news-item:last-child { border-bottom: none; }
.news-type { font-size: 20rpx; padding: 4rpx 12rpx; height: 40rpx; line-height: 32rpx; margin-right: 16rpx; flex-shrink: 0; }
.news-type.official { background: #e8efe8; color: #5A7A5A; }
.news-type.rumor { background: #fbe8e8; color: #C04851; }
.news-body { flex: 1; }
.news-title-ja { font-size: 26rpx; color: #2D2D2D; line-height: 1.4; font-weight: 500; }
.news-summary-zh { font-size: 24rpx; color: #666; line-height: 1.5; margin-top: 6rpx; padding-left: 12rpx; border-left: 3rpx solid #C04851; }
/* 档期报告提醒 */
.reminder-item { padding: 16rpx; background: #fff8e8; border-left: 4rpx solid #E8A838; margin-bottom: 10rpx; }
.reminder-name { font-size: 26rpx; font-weight: 600; color: #2D2D2D; }
.reminder-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; }

/* RSS源 */
/* 今日待办 */
.todo-item { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f0ebe0; }
.todo-priority { width: 60rpx; font-size: 20rpx; padding: 4rpx 8rpx; text-align: center; margin-right: 16rpx; border-radius: 4rpx; }
.todo-priority.high { background: #C04851; color: #fff; }
.todo-priority.medium { background: #E8A838; color: #fff; }
.todo-priority.low { background: #ddd; color: #666; }
.task-name { flex: 1; font-size: 24rpx; color: #444; }

/* 分组标题 */
.group-title { font-size: 22rpx; color: #999; margin: 20rpx 0 10rpx; padding-left: 8rpx; border-left: 3rpx solid #C04851; }

/* 政策源网站标签 */
.sites-grid { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.site-tag { font-size: 20rpx; color: #4A3728; background: #F8F4EC; padding: 8rpx 16rpx; border-radius: 6rpx; border: 1rpx solid #E8E0D0; }
.tip { font-size: 20rpx; color: #999; margin-top: 16rpx; line-height: 1.6; }

/* 快捷入口图标 */
.grid-icon { font-size: 36rpx; text-align: center; margin-bottom: 6rpx; }

/* 双模块卡片 */
.dual-module {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 32rpx;
}
.module-card {
  flex: 1;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}
.module-card.visa {
  background: linear-gradient(135deg, #4A3728 0%, #6B5344 100%);
  color: #F8F4EC;
}
.module-card.estate {
  background: linear-gradient(135deg, #C04851 0%, #D96B72 100%);
  color: #F8F4EC;
}
.module-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}
.module-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}
.module-desc {
  font-size: 22rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
  line-height: 1.5;
}
.module-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}
.module-tags text {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 20rpx;
}