.page { padding-bottom: 60rpx; }
.hero { background: #C04851; padding: 48rpx 40rpx; color: #FDFBF6; }
.hero-title { font-size: 34rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.section { background: #FDFBF6; margin: 24rpx; border: 1rpx solid #e0d8c8; padding: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; letter-spacing: 2rpx; }

.providers { white-space: nowrap; }
.provider {
  display: inline-block; width: 200rpx; margin-right: 16rpx; padding: 16rpx;
  border: 2rpx solid #e0d8c8; text-align: center; vertical-align: top;
}
.provider.active { border-color: #C04851; background: #FDF0F0; }
.p-color { width: 40rpx; height: 40rpx; border-radius: 50%; margin: 0 auto 8rpx; }
.p-name { font-size: 22rpx; font-weight: 600; color: #2D2D2D; }
.p-tag { font-size: 18rpx; color: #999; margin-top: 4rpx; }

.info-row { display: flex; padding: 10rpx 0; border-bottom: 1rpx dashed #e8e0d0; }
.lbl { width: 160rpx; font-size: 22rpx; color: #999; flex-shrink: 0; }
.val { flex: 1; font-size: 22rpx; color: #444; word-break: break-all; }
.guide-link { margin-top: 16rpx; color: #C04851; font-size: 24rpx; }

/* 白名单提示 */
.whitelist-tip {
  background: #FFF8E1;
  border: 1rpx solid #FFB74D;
  padding: 16rpx;
  margin: 20rpx 0;
  font-size: 22rpx;
  color: #E65100;
}
.whitelist-domain {
  background: #fff;
  padding: 8rpx 12rpx;
  margin-top: 8rpx;
  font-family: monospace;
  font-size: 24rpx;
  color: #C62828;
}

.input-row {
  display: flex; align-items: center;
  background: #F8F4EC; padding: 16rpx; border: 1rpx solid #e0d8c8;
}
.input-row input { flex: 1; font-size: 26rpx; }
.toggle { font-size: 24rpx; color: #C04851; padding: 0 16rpx; }
.input-label { font-size: 22rpx; color: #999; margin: 20rpx 0 8rpx; }
.model-input {
  background: #F8F4EC; padding: 16rpx; border: 1rpx solid #e0d8c8; font-size: 26rpx;
}

.actions { display: flex; gap: 16rpx; margin: 0 24rpx; }
.btn { flex: 1; text-align: center; padding: 22rpx 0; font-size: 26rpx; }
.btn.primary { background: #C04851; color: #fff; }
.btn.outline { background: #FDFBF6; color: #C04851; border: 1rpx solid #C04851; }
.btn.danger { background: #FDFBF6; color: #999; border: 1rpx solid #ddd; }
.btn.disabled { opacity: 0.5; }

.test-result {
  margin: 24rpx; padding: 20rpx;
  background: #F8F4EC; border-left: 4rpx solid #C04851;
  font-size: 24rpx; color: #444; line-height: 1.6;
}

.tip { background: #F8F4EC; }
.tip-text { font-size: 22rpx; color: #666; line-height: 1.8; white-space: pre-wrap; }

.whitelist-note { margin-top: 10rpx; font-size: 22rpx; color: #666; line-height: 1.6; }
