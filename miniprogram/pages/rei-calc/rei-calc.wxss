.page { padding-bottom: 40rpx; }
.hero { background: #C04851; padding: 48rpx 40rpx; color: #FDFBF6; }
.hero-title { font-size: 34rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.card { background: #FDFBF6; margin: 24rpx; border: 1rpx solid #e0d8c8; padding: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; letter-spacing: 2rpx; }

.form-row { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid #f0e8d8; }
.fk { width: 300rpx; font-size: 24rpx; color: #666; flex-shrink: 0; }
.fi { flex: 1; font-size: 26rpx; text-align: right; }

.yield-row { display: flex; gap: 24rpx; margin: 24rpx; }
.yield-box { flex: 1; background: #FDFBF6; border: 1rpx solid #e0d8c8; padding: 32rpx; text-align: center; }
.yield-box.hi { background: #C04851; border-color: #C04851; color: #FDFBF6; }
.yield-num { font-size: 56rpx; font-weight: 700; }
.yield-box.hi .yield-num { color: #FDFBF6; }
.pct { font-size: 26rpx; font-weight: 400; }
.yield-label { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.yield-box.hi .yield-label { color: rgba(255,255,255,0.85); }

.kv { display: flex; padding: 12rpx 0; border-bottom: 1rpx dashed #d0c8b8; }
.k { width: 380rpx; font-size: 24rpx; color: #666; }
.v { flex: 1; text-align: right; font-size: 24rpx; }
.kv.total { border-top: 2rpx solid #C04851; border-bottom: none; margin-top: 8rpx; padding-top: 16rpx; }
.kv.total .k, .kv.total .v { font-weight: 700; color: #C04851; }

.disclaimer { font-size: 22rpx; color: #999; line-height: 1.7; }
