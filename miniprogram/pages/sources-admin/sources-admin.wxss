.page { padding: 20rpx; }
.hero { padding: 30rpx 20rpx; }
.hero-title { font-size: 36rpx; font-weight: bold; color: #4A3728; }
.hero-sub { font-size: 24rpx; color: #999; margin-top: 10rpx; }

.card { background: #fff; border-radius: 20rpx; padding: 36rpx; margin: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06); }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; color: #1d1d1f; }
.about { font-size: 24rpx; color: #666; line-height: 1.6; margin-bottom: 16rpx; }

.source-item { padding: 16rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.source-name { font-size: 26rpx; font-weight: 600; color: #1d1d1f; }
.source-cat { font-size: 22rpx; color: #999; margin: 4rpx 0; }
.source-url { font-size: 20rpx; color: #86868b; word-break: break-all; }

.form-row { display: flex; padding: 12rpx 0; }
.fk { width: 120rpx; font-size: 26rpx; color: #999; }
.fi { flex: 1; font-size: 26rpx; border-bottom: 1rpx solid #e0e0e0; }

.btn { text-align: center; padding: 20rpx; border-radius: 16rpx; font-size: 26rpx; margin-top: 16rpx; background: #f5f5f5; }
.btn.primary { background: #4A3728; color: #fff; }
