.page { padding-bottom: 40rpx; }
.profile-card {
  display: flex; align-items: center;
  background: linear-gradient(135deg, #4A3728 0%, #6B5544 100%);
  color: #FDFBF6;
  padding: 60rpx 40rpx;
  position: relative;
}
.profile-card::after {
  content: '❀';
  position: absolute;
  right: 40rpx;
  top: 30rpx;
  font-size: 48rpx;
  color: rgba(255,255,255,0.1);
}
.avatar {
  width: 140rpx; height: 140rpx;
  background: rgba(255,255,255,0.15);
  border: 2rpx solid rgba(255,255,255,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 700; margin-right: 28rpx;
  letter-spacing: 4rpx;
}
.name { font-size: 40rpx; font-weight: 600; letter-spacing: 6rpx; }
.role { font-size: 24rpx; opacity: 0.7; margin-top: 8rpx; }

.card { background: #FDFBF6; margin: 24rpx; border: 1rpx solid #e0d8c8; padding: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; letter-spacing: 2rpx; }
.kv { display: flex; padding: 12rpx 0; }
.k { width: 180rpx; color: #999; font-size: 26rpx; }
.v { flex: 1; font-size: 26rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { background: #e8e0d0; color: #555; padding: 6rpx 16rpx; font-size: 24rpx; }
.cert { padding: 14rpx 0; font-size: 26rpx; border-bottom: 1rpx dashed #d0c8b8; }
.cert:last-child { border-bottom: none; }
.record { display: flex; justify-content: space-between; padding: 16rpx 0; }
.record-label { font-size: 26rpx; color: #555; }
.record-num { font-size: 30rpx; font-weight: 600; color: #4A3728; }
.about { font-size: 24rpx; color: #666; line-height: 1.8; }
.about-item { font-size: 24rpx; color: #666; line-height: 2.0; margin-bottom: 8rpx; }
.about-item:last-child { margin-bottom: 0; }
.about-link { font-size: 26rpx; color: #4A3728; margin-top: 16rpx; }
.version { text-align: center; color: #bbb; font-size: 22rpx; margin-top: 16rpx; }
.input { background: #F5F0E8; padding: 8rpx 16rpx; border-radius: 6rpx; font-size: 24rpx; }
.btn-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.tip { font-size: 20rpx; color: #999; margin-top: 12rpx; }

.advanced-entry { margin-top: 16rpx; padding: 16rpx; background: #F8F4EC; border-left: 4rpx solid #4A3728; font-size: 24rpx; color: #4A3728; }

/* 语言切换 */

/* 顾问信息卡（wxml 使用但此前未定义） */
.info { background: #FFFFFF; margin: 16rpx 24rpx 0; padding: 28rpx; border: 1rpx solid #E2DACD; border-radius: 12rpx; }
