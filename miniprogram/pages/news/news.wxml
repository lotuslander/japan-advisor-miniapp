<view class="page">
  <view class="hero">
    <view class="hero-title">ニュース・政策動向</view>
    <view class="hero-sub">官方动态 {{newsCount}} 条 · AI 更新 {{aiCount}} 条 · 数据保存在本地</view>
  </view>

  <view class="news-item" wx:for="{{list}}" wx:key="id" data-idx="{{index}}" bindtap="openNews">
    <view class="news-type {{item.type}}">{{item.typeLabel}}</view>
    <view class="news-body">
      <view class="news-title-ja">{{item.title}}</view>
      <view class="news-summary-zh" wx:if="{{item.summary}}">{{item.summary}}</view>
      <view class="news-meta">
        {{item.source}}{{item.date ? ' · ' + item.date : ''}}{{item.type === 'ai' && !item.verified ? ' · 待核验' : ''}}{{item.url ? ' · 可查看原文' : ''}}
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !list.length}}">
    <view class="empty-text">暂无动态</view>
    <view class="empty-btn" bindtap="goUpdatePolicy">去 AI 政策更新 ›</view>
  </view>

  <!-- 全局AI浮动按钮 -->
  <global-ai-float></global-ai-float>
</view>
