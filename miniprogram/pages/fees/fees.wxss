.page { padding-bottom: 40rpx; }
.hero { background: #C04851; padding: 48rpx 40rpx; color: #FDFBF6; }
.hero-title { font-size: 34rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.path-row { display: flex; gap: 20rpx; padding: 24rpx; }
.path { font-size: 26rpx; color: #999; padding: 8rpx 28rpx; border: 1rpx solid #d8d0c0; }
.path.active { color: #C04851; border-color: #C04851; font-weight: 600; }

.card { background: #FDFBF6; margin: 24rpx; border: 1rpx solid #e0d8c8; padding: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; letter-spacing: 2rpx; }
.fi { width: 100%; background: #F8F4EC; border: 1rpx solid #e0d8c8; padding: 20rpx; font-size: 30rpx; box-sizing: border-box; }
.form-tip { font-size: 22rpx; color: #999; margin-top: 12rpx; line-height: 1.6; }

.rhead { display: flex; padding: 12rpx 0; border-bottom: 2rpx solid #C04851; font-size: 22rpx; color: #999; }
.row { display: flex; padding: 16rpx 0; border-bottom: 1rpx dashed #d0c8b8; align-items: flex-start; }
.r1 { flex: 1; }
.r-item { font-size: 26rpx; }
.r-note { font-size: 20rpx; color: #999; margin-top: 4rpx; }
.r2 { width: 160rpx; text-align: right; font-size: 24rpx; }
.r3 { width: 160rpx; text-align: right; font-size: 24rpx; color: #C04851; }

.total { display: flex; justify-content: space-between; align-items: center; padding-top: 24rpx; margin-top: 8rpx; border-top: 2rpx solid #C04851; }
.total-label { font-size: 26rpx; color: #666; }
.total-num { font-size: 30rpx; font-weight: 700; color: #C04851; }

.copy-btn { margin-top: 20rpx; background: #C04851; color: #FDFBF6; text-align: center; padding: 20rpx; font-size: 26rpx; }