.page { padding-bottom: 40rpx; }
.hero { background: #C04851; padding: 48rpx 40rpx; color: #FDFBF6; }
.hero-title { font-size: 34rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.path-row { display: flex; gap: 20rpx; padding: 24rpx; overflow-x: auto; }
.path { font-size: 26rpx; color: #999; padding: 8rpx 28rpx; border: 1rpx solid #d8d0c0; white-space: nowrap; }
.path.active { color: #C04851; border-color: #C04851; font-weight: 600; }

.card { background: #FDFBF6; margin: 24rpx; border: 1rpx solid #e0d8c8; padding: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; letter-spacing: 2rpx; }

.form-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f0e8d8; }
.fk { width: 220rpx; font-size: 24rpx; color: #666; flex-shrink: 0; }
.fi { flex: 1; font-size: 26rpx; }
.radios { flex: 1; display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; }
.radio { font-size: 24rpx; color: #555; }

.run-btn { background: #C04851; color: #FDFBF6; text-align: center; padding: 24rpx 0; font-size: 28rpx; letter-spacing: 4rpx; margin-top: 24rpx; }
.form-tip { font-size: 22rpx; color: #999; text-align: center; margin-top: 16rpx; }

.result-hero { padding: 48rpx 40rpx; color: #FDFBF6; text-align: center; }
.fe-high { background: #5A7A5A; }
.fe-medium { background: #B08A5A; }
.fe-low { background: #B8860B; }
.fe-not_recommended { background: #C04851; }
.fe-title { font-size: 36rpx; font-weight: 700; letter-spacing: 4rpx; }
.fe-score { font-size: 72rpx; font-weight: 700; margin-top: 12rpx; }
.fe-unit { font-size: 28rpx; font-weight: 400; opacity: 0.8; }
.fe-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.check { display: flex; padding: 14rpx 0; border-bottom: 1rpx dashed #d0c8b8; }
.check-mark { width: 44rpx; height: 44rpx; border-radius: 50%; margin-right: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; flex-shrink: 0; }
.check-mark.ok { background: #5A7A5A; color: #FDFBF6; }
.check-mark.no { background: #C04851; color: #FDFBF6; }
.check-mark.warn { background: #d0c8b8; color: #FDFBF6; }
.check-body { flex: 1; }
.check-item { font-size: 26rpx; font-weight: 600; }
.check-src { font-size: 20rpx; color: #999; font-weight: 400; }
.check-detail { font-size: 24rpx; color: #666; margin-top: 4rpx; line-height: 1.5; }

.risk { display: flex; padding: 14rpx 0; border-bottom: 1rpx dashed #d0c8b8; }
.risk-level { font-size: 20rpx; padding: 2rpx 12rpx; margin-right: 16rpx; height: fit-content; flex-shrink: 0; }
.risk-high { background: #C04851; color: #FDFBF6; }
.risk-medium { background: #B8860B; color: #FDFBF6; }
.risk-text { flex: 1; font-size: 26rpx; line-height: 1.5; }
.risk-advice { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.rec { font-size: 26rpx; color: #555; line-height: 1.7; padding: 6rpx 0; }

.sim { padding: 14rpx 0; border-bottom: 1rpx dashed #d0c8b8; }
.sim-title { font-size: 26rpx; font-weight: 600; }
.sim-meta { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.src { padding: 14rpx 0; border-bottom: 1rpx dashed #d0c8b8; }
.src-title { font-size: 26rpx; color: #C04851; }
.src-url { font-size: 20rpx; color: #999; word-break: break-all; margin-top: 4rpx; }
.disclaimer { font-size: 22rpx; color: #999; line-height: 1.6; margin-top: 16rpx; }

.empty-tip { font-size: 24rpx; color: #bbb; padding: 12rpx 0; }
.again-btn { margin: 8rpx 24rpx; border: 1rpx solid #C04851; color: #C04851; text-align: center; padding: 22rpx 0; font-size: 28rpx; }
.empty { text-align: center; color: #999; padding: 120rpx 0; }
.empty-btn {
  display: inline-block; margin-top: 24rpx; padding: 12rpx 40rpx;
  border: 1rpx solid #C04851; color: #C04851; font-size: 24rpx;
}

.rule-row { display: flex; align-items: flex-start; padding: 14rpx 0; border-bottom: 1rpx dashed #d0c8b8; }
.rule-dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 16rpx; margin-top: 6rpx; flex-shrink: 0; }
.rule-dot.g { background: #4a9d5b; }
.rule-dot.r { background: #C04851; }
.rule-dot.y { background: #E8A838; }
.rule-body { flex: 1; }
.rule-label { font-size: 26rpx; font-weight: 600; color: #2D2D2D; }
.rule-detail { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.rule-advice { margin-top: 20rpx; padding: 16rpx; background: #F8F4EC; border-left: 4rpx solid #C04851; font-size: 24rpx; color: #C04851; }

/* HSP积分计算器 */
.calc-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx dashed #e8e0d0; }
.calc-lbl { width: 160rpx; font-size: 26rpx; color: #666; }
.calc-pick { flex: 1; font-size: 26rpx; color: #C04851; }
.calc-input { flex: 1; font-size: 26rpx; }
.calc-btn { background: #C04851; color: #fff; text-align: center; padding: 22rpx; margin-top: 24rpx; }
.hsp-result { margin-top: 24rpx; padding: 24rpx; background: #F8F4EC; }
.hsp-total { font-size: 48rpx; font-weight: 700; color: #C04851; text-align: center; }
.hsp-level { text-align: center; font-size: 26rpx; padding: 12rpx; margin: 12rpx 0; }
.hsp-level.gold { background: #E8A838; color: #fff; }
.hsp-level.green { background: #4a9d5b; color: #fff; }
.hsp-level.red { background: #C04851; color: #fff; }
.hsp-advice { font-size: 24rpx; color: #666; line-height: 1.6; margin-bottom: 16rpx; }
.hsp-item { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 22rpx; border-top: 1rpx dotted #ddd; }
.hsp-pts { color: #C04851; font-weight: 600; }

/* 时间线 */
.tl-list { position: relative; padding-left: 20rpx; }
.tl-stage { display: flex; padding: 12rpx 0; position: relative; }
.tl-dot { width: 16rpx; height: 16rpx; background: #C04851; border-radius: 50%; margin-top: 8rpx; flex-shrink: 0; }
.tl-info { flex: 1; margin-left: 20rpx; }
.tl-name { font-size: 26rpx; font-weight: 600; color: #2D2D2D; }
.tl-days { font-size: 22rpx; color: #C04851; margin-left: 12rpx; }
.tl-desc { font-size: 22rpx; color: #888; margin-top: 4rpx; }

/* 合规自检 */
.check-pass { padding: 12rpx; margin: 8rpx 0; font-size: 24rpx; }
.ok-dot { color: #4a9d5b; font-weight: bold; margin-right: 8rpx; }
.check-warn { padding: 12rpx; margin: 8rpx 0; font-size: 24rpx; background: #fff8e8; }
.warn-dot { color: #E8A838; font-weight: bold; margin-right: 8rpx; }

/* 主按钮与空态（wxml 使用但此前未定义） */
.btn.primary { background: #1F3A5F; color: #FFFFFF; }
.empty-text { font-size: 24rpx; color: #6B6259; text-align: center; padding: 40rpx 0; }