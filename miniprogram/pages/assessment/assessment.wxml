<!-- 个案评估 -->
<view class="page">

  <view class="hero">
    <view class="hero-title">個案評価</view>
    <view class="hero-sub">画像 × 现行政策 × 历史案例 → 可行性分级，依据可追溯</view>
    <view class="btn primary" bindtap="autoCheck">🔍 一键合规自检（5条红线自动跑）</view>
  </view>

  <!-- 合规自检结果 -->
  <view class="card" wx:if="{{checkResult}}">
    <view class="section-title">✅ 合规自检结果（{{checkResult.summary.risk_level}}风险）</view>
    <view class="check-pass" wx:for="{{checkResult.pass}}" wx:key="rule">
      <text class="ok-dot">✓</text> {{item.rule}}：{{item.result}}
    </view>
    <view class="check-warn" wx:for="{{checkResult.warnings}}" wx:key="rule">
      <text class="warn-dot">⚠</text> {{item.rule}}：{{item.result}}
    </view>
  </view>

  <!-- 路径选择 -->
  <view class="path-row">
    <text class="path {{path===item.key?'active':''}}" wx:for="{{paths}}" wx:key="key"
          data-key="{{item.key}}" bindtap="setPath">{{item.label}}</text>
  </view>

  <!-- 高度人才积分速算（仅hsp路径） -->
  <view class="card" wx:if="{{path==='hsp'}}">
    <view class="section-title">🎯 高度人才积分速算</view>
    <view class="calc-row">
      <text class="calc-lbl">学历</text>
      <picker range="{{eduOptions}}" range-key="label" bindchange="pickEdu">
        <view class="calc-pick">{{hsp.eduLabel || '点击选择'}}</view>
      </picker>
    </view>
    <view class="calc-row">
      <text class="calc-lbl">职历</text>
      <picker range="{{careerOptions}}" range-key="label" bindchange="pickCareer">
        <view class="calc-pick">{{hsp.careerLabel || '点击选择'}}</view>
      </picker>
    </view>
    <view class="calc-row">
      <text class="calc-lbl">年收(万円)</text>
      <input type="number" class="calc-input" value="{{hsp.income_wan}}" data-k="income_wan" bindinput="onHspInput" />
    </view>
    <view class="calc-row">
      <text class="calc-lbl">年龄</text>
      <picker range="{{ageOptions}}" range-key="label" bindchange="pickAge">
        <view class="calc-pick">{{hsp.ageLabel || '点击选择'}}</view>
      </picker>
    </view>
    <view class="calc-row">
      <text class="calc-lbl">日语</text>
      <picker range="{{jpOptions}}" range-key="label" bindchange="pickJp">
        <view class="calc-pick">{{hsp.jpLabel || '点击选择'}}</view>
      </picker>
    </view>
    <view class="btn calc-btn" bindtap="runHspCalc">计算积分</view>
    <view class="hsp-result" wx:if="{{hspResult}}">
      <view class="hsp-total">{{hspResult.total}} 分</view>
      <view class="hsp-level {{hspResult.total>=80?'gold':(hspResult.total>=70?'green':'red')}}">{{hspResult.level}}</view>
      <view class="hsp-advice">{{hspResult.advice}}</view>
      <view class="hsp-item" wx:for="{{hspResult.items}}" wx:key="label">
        <text>{{item.label}}（{{item.detail}}）</text><text class="hsp-pts">+{{item.points}}</text>
      </view>
    </view>
  </view>

  <!-- 不动产ROI计算器（仅realestate路径） -->
  <view class="card" wx:if="{{path==='realestate'}}">
    <view class="section-title">🏠 不动产ROI速算</view>
    <view class="calc-row"><text class="calc-lbl">房价(万円)</text><input type="number" class="calc-input" value="{{re.price_wan}}" data-k="price_wan" bindinput="onReInput" /></view>
    <view class="calc-row"><text class="calc-lbl">首付%</text><input type="number" class="calc-input" value="{{re.down_pct}}" data-k="down_pct" bindinput="onReInput" /></view>
    <view class="calc-row"><text class="calc-lbl">利率%</text><input type="number" class="calc-input" value="{{re.interest_rate}}" data-k="interest_rate" bindinput="onReInput" /></view>
    <view class="calc-row"><text class="calc-lbl">年租金(万円)</text><input type="number" class="calc-input" value="{{re.rent_wan}}" data-k="rent_wan" bindinput="onReInput" /></view>
    <view class="calc-row"><text class="calc-lbl">管理费+修缮(万/年)</text><input type="number" class="calc-input" value="{{re.mgmt_wan}}" data-k="mgmt_wan" bindinput="onReInput" /></view>
    <view class="calc-row"><text class="calc-lbl">固定资产税(万/年)</text><input type="number" class="calc-input" value="{{re.tax_wan}}" data-k="tax_wan" bindinput="onReInput" /></view>
    <view class="btn calc-btn" bindtap="runReCalc">计算ROI</view>
    <view class="hsp-result" wx:if="{{reResult}}">
      <view class="hsp-total">{{reResult.net_yield}}%</view>
      <view class="hsp-level green">{{reResult.verdict}}</view>
      <view class="hsp-advice">{{reResult.advice}}</view>
      <view class="hsp-item"><text>表面回报率</text><text class="hsp-pts">{{reResult.gross_yield}}%</text></view>
      <view class="hsp-item"><text>实质回报率</text><text class="hsp-pts">{{reResult.net_yield}}%</text></view>
      <view class="hsp-item"><text>年现金流</text><text class="hsp-pts">{{reResult.cash_flow_wan}}万</text></view>
      <view class="hsp-item"><text>现金回报率</text><text class="hsp-pts">{{reResult.cash_on_cash}}%</text></view>
    </view>
  </view>

  <!-- 流程时间线（所有路径） -->
  <view class="card">
    <view class="section-title">📅 流程时间线（平均周期）</view>
    <view class="tl-list" wx:if="{{timeline}}">
      <view class="tl-stage" wx:for="{{timeline.stages}}" wx:key="stage">
        <view class="tl-dot"></view>
        <view class="tl-info">
          <view class="tl-name">{{item.stage}} <text class="tl-days">~{{item.days}}天</text></view>
          <view class="tl-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
    <view class="empty" wx:else>选择路径后自动加载</view>
  </view>

  <!-- 表单 -->
  <view class="card" wx:if="{{!result}}">
    <view class="section-title">客户画像</view>

    <view class="form-row">
      <text class="fk">年龄</text>
      <input class="fi" type="number" placeholder="如 38" value="{{form.age}}" data-k="age" bindinput="onInput" />
    </view>

    <block wx:if="{{path !== 'realestate'}}">
      <view class="form-row">
        <text class="fk">学历</text>
        <view class="radios">
          <label class="radio"><radio value="doctor" checked="{{form.education==='doctor'}}" data-k="education" bindchange="onRadio" /> 博士</label>
          <label class="radio"><radio value="master" checked="{{form.education==='master'}}" data-k="education" bindchange="onRadio" /> 硕士</label>
          <label class="radio"><radio value="bachelor" checked="{{form.education==='bachelor'}}" data-k="education" bindchange="onRadio" /> 本科</label>
          <label class="radio"><radio value="other" checked="{{form.education==='other'}}" data-k="education" bindchange="onRadio" /> 其他</label>
        </view>
      </view>

      <view class="form-row">
        <text class="fk">日语水平</text>
        <view class="radios">
          <label class="radio"><radio value="n1" checked="{{form.japanese_level==='n1'}}" data-k="japanese_level" bindchange="onRadio" /> N1</label>
          <label class="radio"><radio value="n2" checked="{{form.japanese_level==='n2'}}" data-k="japanese_level" bindchange="onRadio" /> N2</label>
          <label class="radio"><radio value="bjt400" checked="{{form.japanese_level==='bjt400'}}" data-k="japanese_level" bindchange="onRadio" /> BJT400</label>
          <label class="radio"><radio value="n3" checked="{{form.japanese_level==='n3'}}" data-k="japanese_level" bindchange="onRadio" /> N3</label>
          <label class="radio"><radio value="none" checked="{{form.japanese_level==='none'}}" data-k="japanese_level" bindchange="onRadio" /> 无</label>
        </view>
      </view>
    </block>

    <block wx:if="{{path === 'business_manager' || path === 'hsp'}}">
      <view class="form-row">
        <text class="fk">年收（日元）</text>
        <input class="fi" type="number" placeholder="如 20000000" value="{{form.annual_income_jpy}}" data-k="annual_income_jpy" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="fk">管理经验（年）</text>
        <input class="fi" type="number" placeholder="如 5" value="{{form.years_experience}}" data-k="years_experience" bindinput="onInput" />
      </view>
    </block>

    <block wx:if="{{path === 'business_manager'}}">
      <view class="form-row">
        <text class="fk">可用资本金（日元）</text>
        <input class="fi" type="number" placeholder="如 30000000" value="{{form.budget_jpy}}" data-k="budget_jpy" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="fk">事业内容</text>
        <input class="fi" placeholder="如 跨境电商/餐饮/民宿" value="{{form.business_type}}" data-k="business_type" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="fk">常勤职员安排</text>
        <switch checked="{{form.fulltime_employee}}" color="#C04851" data-k="fulltime_employee" bindchange="onSwitch" />
      </view>
      <view class="form-row">
        <text class="fk">专家确认已预约</text>
        <switch checked="{{form.expert_review}}" color="#C04851" data-k="expert_review" bindchange="onSwitch" />
      </view>
      <view class="form-row">
        <text class="fk">独立事务所（非自宅）</text>
        <switch checked="{{form.independent_office}}" color="#C04851" data-k="independent_office" bindchange="onSwitch" />
      </view>
    </block>

    <block wx:if="{{path === 'pr'}}">
      <view class="form-row">
        <text class="fk">在日年限</text>
        <input class="fi" type="number" placeholder="如 10" value="{{form.residence_years}}" data-k="residence_years" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="fk">年收（日元）</text>
        <input class="fi" type="number" placeholder="如 15000000" value="{{form.annual_income_jpy}}" data-k="annual_income_jpy" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="fk">纳税·年金·医保履行</text>
        <switch checked="{{form.tax_ok}}" color="#C04851" data-k="tax_ok" bindchange="onSwitch" />
      </view>
      <view class="form-row">
        <text class="fk">素行无重大违法/滞纳</text>
        <switch checked="{{form.good_conduct}}" color="#C04851" data-k="good_conduct" bindchange="onSwitch" />
      </view>
    </block>

    <block wx:if="{{path === 'realestate'}}">
      <view class="form-row">
        <text class="fk">非居住者购房</text>
        <switch checked="{{form.non_resident}}" color="#C04851" data-k="non_resident" bindchange="onSwitch" />
      </view>
      <view class="form-row">
        <text class="fk">资金来源可追溯</text>
        <switch checked="{{form.fund_ok}}" color="#C04851" data-k="fund_ok" bindchange="onSwitch" />
      </view>
    </block>

    <view class="run-btn" bindtap="runAssess">生成评估</view>
    <view class="form-tip">评估为规则推演，仅供研判参考，不构成审批承诺。</view>
  </view>

  <!-- 结果 -->
  <block wx:if="{{result}}">
    <view class="result-hero fe-{{result.feasibility}}">
      <view class="fe-title">{{feLabel(result.feasibility)}}</view>
      <view class="fe-score">{{result.score}}<text class="fe-unit">/100</text></view>
      <view class="fe-sub">检查 {{result.passed}}/{{result.total}} 项通过</view>
    </view>

    <!-- 规则引擎红黄绿 -->
    <view class="card" wx:if="{{result.ruleChecks}}">
      <view class="section-title">硬规则检查（红=必须解决，黄=建议注意）</view>
      <view class="rule-row" wx:for="{{result.ruleChecks}}" wx:key="id">
        <view class="rule-dot {{item.pass ? 'g' : (item.severity === 'red' ? 'r' : 'y')}}"></view>
        <view class="rule-body">
          <view class="rule-label">{{item.label}}</view>
          <view class="rule-detail">{{item.detail}}</view>
        </view>
      </view>
      <view class="rule-advice" wx:if="{{result.ruleAdvice}}">👉 {{result.ruleAdvice}}</view>
    </view>

    <view class="card">
      <view class="section-title">硬性检查项</view>
      <view class="check" wx:for="{{result.checks}}" wx:key="item">
        <view class="check-mark {{item.passed === true ? 'ok' : (item.passed === false ? 'no' : 'warn')}}">{{item.passed === true ? '✓' : (item.passed === false ? '✕' : '—')}}</view>
        <view class="check-body">
          <view class="check-item">{{item.item}} <text class="check-src" wx:if="{{item.source}}">· {{item.source}}</text></view>
          <view class="check-detail">{{item.detail}}</view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">风险与建议</view>
      <view class="risk" wx:for="{{result.risks}}" wx:key="risk">
        <view class="risk-level risk-{{item.level}}">{{item.level === 'high' ? '高风险' : '中风险'}}</view>
        <view class="risk-text">{{item.risk}}<view class="risk-advice">{{item.advice}}</view></view>
      </view>
      <view class="empty-tip" wx:if="{{!result.risks.length}}">未发现明显风险项，仍需个案审查确认</view>
      <view class="rec" wx:for="{{result.recommendations}}" wx:key="*this">· {{item}}</view>
    </view>

    <view class="card">
      <view class="section-title">相似案例参考</view>
      <view class="sim" wx:for="{{result.similarCases}}" wx:key="title">
        <view class="sim-title">{{item.title}}</view>
        <view class="sim-meta">{{item.resultLabel}} · {{item.duration ? item.duration + '个月' : '时长未记录'}} · {{item.tags.join(' / ')}}</view>
      </view>
      <view class="empty-tip" wx:if="{{!result.similarCases.length}}">暂无高度相似案例</view>
    </view>

    <view class="card">
      <view class="section-title">政策依据（原文回链）</view>
      <view class="src" wx:for="{{result.sources}}" wx:key="url" data-url="{{item.url}}" bindtap="copySource">
        <view class="src-title">{{item.title}}</view>
        <view class="src-url">{{item.url}}</view>
      </view>
      <view class="disclaimer">{{result.disclaimer}}</view>
    </view>

    <view class="again-btn" bindtap="reset">重新评估</view>
  </block>

  <view class="empty" wx:if="{{error}}">
    <view class="empty-text">评估失败，请检查网络或补充信息</view>
    <view class="empty-btn" bindtap="runAssess">重试</view>
  </view>

  <!-- 全局AI浮动按钮 -->
  <global-ai-float></global-ai-float>
</view>
