.page { padding-bottom: 40rpx; }
.top-bar { display: flex; padding: 24rpx; gap: 16rpx; align-items: center; }
.search-wrap { flex: 1; position: relative; }
.search { width: 100%; background: #FDFBF6; border: 1rpx solid #e0d8c8; padding: 16rpx 24rpx; font-size: 26rpx; }
.search-clear { position: absolute; right: 16rpx; top: 50%; transform: translateY(-50%); color: #999; font-size: 32rpx; padding: 8rpx; }
.add-btn { background: #C04851; color: #FDFBF6; padding: 14rpx 24rpx; font-size: 26rpx; letter-spacing: 1rpx; }

.data-row { display: flex; align-items: center; gap: 16rpx; padding: 0 24rpx 16rpx; flex-wrap: wrap; }
.data-btn { border: 1rpx solid #C04851; color: #C04851; padding: 8rpx 20rpx; font-size: 22rpx; }
.data-hint { font-size: 20rpx; color: #999; flex: 1; min-width: 200rpx; }

.filter-row { display: flex; padding: 0 24rpx 16rpx; gap: 24rpx; }
.filter { font-size: 26rpx; color: #999; }
.filter.active { color: #2D2D2D; font-weight: 600; }

.client-card {
  background: #FDFBF6; margin: 0 24rpx 16rpx; padding: 28rpx;
  border: 1rpx solid #e0d8c8; display: flex; align-items: center;
}
.avatar {
  width: 80rpx; height: 80rpx;
  background: #e8e0d0; color: #2D2D2D;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600; margin-right: 20rpx;
}
.info { flex: 1; }
.name-row { display: flex; align-items: center; gap: 12rpx; }
.name { font-size: 30rpx; font-weight: 600; }
.stage-tag { font-size: 20rpx; padding: 2rpx 12rpx; }
.stage-evaluating { background: #7A8B9E; color: #FDFBF6; }
.stage-confirmed { background: #B8860B; color: #FDFBF6; }
.stage-executing { background: #C04851; color: #FDFBF6; }
.stage-landed { background: #5A7A5A; color: #FDFBF6; }
.stage-closed { background: #999; color: #FDFBF6; }
.meta { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.last-follow { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.empty { text-align: center; color: #999; padding: 120rpx 0; }
.empty-icon { font-size: 48rpx; color: #d0c8b8; }
.empty-text { font-size: 24rpx; color: #999; margin-top: 16rpx; }
.empty-btn {
  display: inline-block; margin-top: 24rpx; padding: 12rpx 40rpx;
  border: 1rpx solid #C04851; color: #C04851; font-size: 24rpx;
}

.overdue { color: #C04851; font-weight: 600; margin-left: 8rpx; }