.page { padding-bottom: 40rpx; }
.card { background: #FDFBF6; margin: 24rpx; border: 1rpx solid #e0d8c8; padding: 32rpx; }
.section-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; letter-spacing: 2rpx; }
.path-option { border: 2rpx solid #e0d8c8; padding: 24rpx; margin-bottom: 16rpx; }
.path-option.active { border-color: #C04851; background: rgba(192,72,81,0.05); }
.path-name { font-size: 28rpx; font-weight: 600; }
.path-desc { font-size: 24rpx; color: #999; margin-top: 6rpx; }
.form-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #e8e0d0; }
.label { width: 200rpx; font-size: 26rpx; color: #999; }
.form-row input { flex: 1; font-size: 28rpx; }
.save-btn { margin: 0 24rpx; padding: 28rpx; background: #C04851; color: #FDFBF6; text-align: center; font-weight: 600; letter-spacing: 2rpx; }
