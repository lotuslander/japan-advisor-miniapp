.page { padding-bottom: 60rpx; }
.hero { background: #C04851; padding: 48rpx 40rpx; color: #FDFBF6; }
.hero-title { font-size: 34rpx; font-weight: 600; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.card { background: #FDFBF6; margin: 24rpx; border: 1rpx solid #e0d8c8; padding: 32rpx; }
.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.btn { text-align: center; padding: 24rpx; font-size: 28rpx; }
.btn.primary { background: #C04851; color: #fff; }
.btn.disabled { opacity: 0.5; }
.tip { font-size: 22rpx; color: #999; margin-top: 16rpx; text-align: center; }

/* 表单样式 */
.input {
  background: #F8F4EC; padding: 20rpx;
  margin-bottom: 16rpx; font-size: 26rpx;
  border: 1rpx solid #e0d8c8;
}
.textarea {
  background: #F8F4EC; padding: 20rpx;
  margin-bottom: 16rpx; font-size: 26rpx;
  border: 1rpx solid #e0d8c8;
  height: 200rpx;
}

/* 自定义政策列表 */
.custom-policy {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed #e8e0d0;
}
.custom-policy:last-child { border-bottom: none; }
.custom-policy-title { font-size: 28rpx; font-weight: 600; color: #2D2D2D; margin-bottom: 8rpx; }
.custom-policy-summary { font-size: 24rpx; color: #555; line-height: 1.8; margin-bottom: 8rpx; white-space: pre-wrap; word-wrap: break-word; }
.custom-policy-meta { font-size: 20rpx; color: #999; margin-bottom: 12rpx; }
.btn.small { padding: 12rpx 24rpx; font-size: 22rpx; display: inline-block; }
.btn.danger { background: #C04851; color: #fff; }

/* 政策详细展开 */
.policy-detail {
  margin-top: 16rpx; padding: 20rpx;
  background: #F8F4EC; border-radius: 8rpx;
  border-left: 4rpx solid #4A3728;
}
.detail-row { font-size: 24rpx; color: #444; margin-bottom: 8rpx; line-height: 1.6; }
.detail-label { color: #4A3728; font-weight: 600; }
.detail-content { font-size: 24rpx; color: #333; line-height: 1.8; margin: 8rpx 0; white-space: pre-wrap; }
