.progress-container {
  background: #FDFBF6;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 20rpx 0;
  border: 1rpx solid #E8DFD0;
}
.progress-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3728;
  margin-bottom: 30rpx;
}
.progress-stages {
  display: flex;
  justify-content: space-between;
  position: relative;
}
.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}
.stage-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #E8DFD0;
  color: #999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  z-index: 2;
}
.stage.done .stage-dot {
  background: #4A3728;
  color: #F8F4EC;
}
.stage.current .stage-dot {
  background: #C04851;
  color: #F8F4EC;
  box-shadow: 0 0 0 8rpx rgba(192, 72, 81, 0.2);
}
.stage-label {
  font-size: 20rpx;
  color: #999;
  margin-top: 12rpx;
  text-align: center;
}
.stage.done .stage-label,
.stage.current .stage-label {
  color: #4A3728;
  font-weight: 500;
}
.stage-line {
  position: absolute;
  top: 24rpx;
  left: 60%;
  width: 80%;
  height: 2rpx;
  background: #E8DFD0;
  z-index: 1;
}
.stage.done .stage-line {
  background: #4A3728;
}